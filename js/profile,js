+'<section class="card"><h2>Где и как проходит приём</h2><dl><dt>Адрес</dt><dd>'+esc(s.addr)+'</dd><dt>Лифт</dt><dd>'+yn('Лифт')+'</dd><dt>С сопровождающим</dt><dd>'+yn('С сопровождающим')+'</dd><dt>Тихая зона</dt><dd>'+yn('Тихая зона')+'</dd><dt>Оплата</dt><dd>'+s.pay.join(', ')+'</dd><dt>Онлайн</dt><dd>'+(s.fmt.indexOf('Онлайн')>-1?'Да':'Нет')+'</dd></dl><div class="two" style="margin-top:12px"><div class="ph">Фото кабинета (демо)</div><a class="ph" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(s.addr)+'">📍 Открыть карту</a></div></section>'
+'<section class="card" id="book"><h2>Записаться</h2><label for="b-s">1. Услуга</label><select id="b-s">'+opt(s.svc.map(function(x,i){return[i,x[0]+' — '+x[2]]}))+'</select><label for="b-d">2. Дата</label><select id="b-d">'+opt(DL)+'</select><label for="b-t">3. Время</label><select id="b-t"></select><label for="b-n">4. Имя взрослого</label><input id="b-n" autocomplete="name"><label for="b-p">Телефон</label><input id="b-p" type="tel" autocomplete="tel"><label class="ck"><input type="checkbox" id="b-c">5. Принимаю правила записи и согласен(на) передать специалисту имя, телефон и выбранную услугу. Данные о здоровье ребёнка не передаются.</label><p class="err" id="b-e"></p><button class="btn full" id="b-go">Подтвердить запись</button></section>'
