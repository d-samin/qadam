// js/profile.js — страница специалиста: проверка, услуги, условия, отзывы, запись, вопрос
(function(){var $=function(s){return document.querySelector(s)},A=$('#app'),id=+new URLSearchParams(location.search).get('id'),s=SPEC.filter(function(x){return x.id==id})[0];
