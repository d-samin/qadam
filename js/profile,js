var DL=days(),bk=ls('bk',[]).filter(function(b){return b.sp==s.id});
A.innerHTML='<p class="mute"><a href="index.html#specialists">Специалисты</a> › '+esc(s.name)+'</p>'
+'<section class="card"><div class="hd"><div class="av2" style="--h:'+(s.id*57%360)+';width:96px;height:96px;font-size:34px">'+s.name.split(' ').map(function(w){return w[0]}).join('')+'</div><div><h1 style="margin:0">'+esc(s.name)+'</h1><b>'+esc(s.role)+' · '+s.exp+' лет опыта</b><div class="st">★ '+s.rating.toFixed(1)+' <small class="mute">('+s.rev+' отзывов)</small></div></div></div><p>'+esc(s.bio)+'</p><p class="mute">Языки: '+s.langs.map(L).join(' / ')+' · Город: '+s.city+'</p><div class="row"><a class="btn" href="#book">Записаться</a><a class="btn out" href="#ask">Задать вопрос</a></div></section>'
