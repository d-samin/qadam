function fill(){$('#b-t').innerHTML=DL.length?opt(slots($('#b-d').value)):''}fill();$('#b-d').onchange=fill;
$('#b-go').onclick=function(){var n=$('#b-n').value.trim(),p=$('#b-p').value.trim(),e=$('#b-e');if(!$('#b-t').value||n.length<2||!/^\+?[0-9 ()-]{10,18}$/.test(p)){e.textContent='Выберите время, укажите имя и телефон';return}if(!$('#b-c').checked){e.textContent='Нужно подтвердить правила';return}
