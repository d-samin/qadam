$('#q-go').onclick=function(){var c=$('#q-p').value.trim();if(c.length<5){$('#q-e').textContent='Укажите контакт';return}var a=ls('qs',[]);a.push({sp:s.id,t:$('#q-t').value,c:c});sv('qs',a);$('#ask').innerHTML='<h2>Вопрос отправлен</h2><p>Специалист ответит по указанному контакту.</p>'};
