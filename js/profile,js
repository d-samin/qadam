+'<section class="card"><h2>С чем работает</h2><dl><dt>Возраст детей</dt><dd>'+s.ages[0]+'–'+s.ages[1]+' лет</dd><dt>Направления</dt><dd>'+esc(s.tags.join('; '))+'</dd><dt>Методы</dt><dd>'+esc(s.met.join('; '))+'</dd><dt>Ограничения компетенции</dt><dd>'+esc(s.lim)+'</dd></dl></section>'
